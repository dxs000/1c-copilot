[Unit]
Description=1С Project Copilot — ядро (демон API на 127.0.0.1:8100)
Documentation=https://github.com/dxs000/1c-copilot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=copilot
Group=copilot
# Настройки (.env), кэш (.cache: манифест индекса, OCR) и материалы (data) — в рабочем каталоге
WorkingDirectory=/opt/1c-copilot
ExecStart=/opt/1c-copilot/.venv/bin/copilot1c serve --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=5

# Ограничения: писать можно только в кэш, папку материалов и вложения обращений; порт 8100 — без особых прав.
# Новая папка, в которую пишет ядро, должна быть добавлена сюда — иначе «Read-only file system».
# Папки создаёт ExecStartPre (с «+» — от root). Песочницу systemd строит и для него, поэтому пути в
# ReadWritePaths — с «-»: отсутствующая папка не мешает запуску, а к старту основного процесса она уже создана.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ExecStartPre=+/usr/bin/install -d -o copilot -g copilot /opt/1c-copilot/.cache /opt/1c-copilot/data /opt/1c-copilot/issues
ReadWritePaths=-/opt/1c-copilot/.cache -/opt/1c-copilot/data -/opt/1c-copilot/issues

[Install]
WantedBy=multi-user.target
