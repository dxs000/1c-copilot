# Скопируйте в .env и заполните. Имена моделей сверьте со списком в Model Gallery AI Studio:
# https://aistudio.yandex.ru/docs/en/ai-studio/concepts/generation/models.html
COPILOT_YC_FOLDER_ID=
COPILOT_YC_API_KEY=
COPILOT_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1

COPILOT_MODEL_ORCHESTRATOR=gpt-oss-120b/latest
COPILOT_MODEL_CODE=qwen3-235b-a22b-fp8/latest
COPILOT_MODEL_LONG_CONTEXT=deepseek-v4-flash/latest
COPILOT_MODEL_BUSINESS_TEXT=aliceai-llm
COPILOT_MODEL_BATCH=yandexgpt-lite/latest
COPILOT_EMBEDDING_DOC=text-search-doc/latest
COPILOT_EMBEDDING_QUERY=text-search-query/latest

COPILOT_PG_DSN=postgresql://copilot:copilot@localhost:5432/copilot
COPILOT_S3_BUCKET=copilot1c-sources
COPILOT_PROJECT=ut11-update

COPILOT_ONEC_BIN=/opt/1cv8/x86_64/8.3.27.2342/1cv8
COPILOT_IBCMD_BIN=/opt/1cv8/x86_64/8.3.27.2342/ibcmd
COPILOT_SANDBOX_IB_PATH=/var/lib/copilot1c/sandbox-ib
