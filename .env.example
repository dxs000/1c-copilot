# Скопируйте в .env и заполните. Имена моделей сверьте со списком в Model Gallery AI Studio:
# https://aistudio.yandex.ru/docs/en/ai-studio/concepts/generation/models.html
COPILOT_YC_FOLDER_ID=
COPILOT_YC_API_KEY=
COPILOT_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1

COPILOT_MODEL_ORCHESTRATOR=gpt-oss-120b/latest
COPILOT_MODEL_CODE=qwen3-235b-a22b-fp8/latest
COPILOT_MODEL_LONG_CONTEXT=deepseek-v4-flash/latest
COPILOT_MODEL_BUSINESS_TEXT=aliceai-llm
COPILOT_MODEL_BATCH=yandexgpt-lite/latest
COPILOT_EMBEDDING_DOC=text-search-doc/latest
COPILOT_EMBEDDING_QUERY=text-search-query/latest

# PostgreSQL с pgvector: база поиска (фрагменты и эмбеддинги), граф, реестры, обращения
COPILOT_PG_DSN=postgresql://copilot:copilot@localhost:5432/copilot
COPILOT_S3_BUCKET=copilot1c-sources
# Код базы (клиента): все материалы, контуры и обращения живут внутри него. Темы и системы внутри базы —
# контуры (copilot1c contours), а не отдельные проекты.
COPILOT_PROJECT=ut11-update

# Модель (COPILOT_MODEL_BATCH) для сводок веток переписки и разбора входящих; false — шаблоны и эвристики
COPILOT_THREAD_SUMMARY_LLM=true
COPILOT_INTAKE_LLM=true

# Vision OCR: не чаще N запросов в секунду (квота каталога), повторы при 429, кэш распознанного
COPILOT_OCR_RPS=1
COPILOT_OCR_MAX_RETRIES=5
COPILOT_CACHE_DIR=.cache
# auto | yandex | tesseract | none — none отключает распознавание картинок
COPILOT_OCR_BACKEND=auto

COPILOT_ONEC_BIN=/opt/1cv8/x86_64/8.3.27.2342/1cv8
COPILOT_IBCMD_BIN=/opt/1cv8/x86_64/8.3.27.2342/ibcmd
COPILOT_SANDBOX_IB_PATH=/var/lib/copilot1c/sandbox-ib

# Обращения: аналитики — для «кто завёл» и «ответственный» (через запятую или JSON-списком)
# COPILOT_ANALYSTS=Иванов И., Петрова А.
# Разбор письма в обращение: свои домены и адреса аналитиков. Инициатор — последний автор цепочки
# из своих доменов, который не аналитик (аналитики и пользователи — сотрудники одной организации)
# COPILOT_INTERNAL_DOMAINS=pierre-fabre.com
# COPILOT_ANALYST_EMAILS=i.ivanov@pierre-fabre.com, a.petrova@pierre-fabre.com

# Тип сообщения в чате (вопрос, проблема, сводка, документ, знание): спорные случаи эвристик уточняет
# модель COPILOT_MODEL_BATCH; false — только эвристики (быстрее, без вызова AI Studio)
# COPILOT_INTENT_LLM=true

# Поиск в интернете для агента (Yandex Search API v2, тот же ключ AI Studio — нужна роль search-api.webSearch.user).
# Агент ищет в интернете только если ответа нет в базе. Наружу уходят тексты ошибок, объекты 1С, версии; имена,
# e-mail, телефоны, серверы, внутренние адреса, свои домены и слова из списка ниже вырезаются. Журнал запросов —
# .cache/web/web_search.jsonl. Проверка: uv run copilot1c web-search "Поле объекта не обнаружено" --site its.1c.ru
# COPILOT_WEB_SEARCH=true
# COPILOT_WEB_MAX_SEARCHES=3
# COPILOT_WEB_MAX_PAGES=3
# COPILOT_WEB_BLOCKED_TERMS=Pierre Fabre, Пьер Фабр

# Секретарь (вкладка «Секретарь» веба): место, рабочие сессии и перерывы с таймером. Только Yandex Cloud:
# незнакомые города и непонятые правилами фразы — модель COPILOT_MODEL_BATCH; погода сейчас — Yandex Search API
# (роль search-api.webSearch.user, как у поиска агента) по Яндекс Погоде + модель. Пояс, когда место не указано, —
# COPILOT_SECRETARY_DEFAULT_TZ (пусто — пояс хоста). Таблицы sec_* ядро создаёт само.
# COPILOT_SECRETARY_LLM=true
# COPILOT_SECRETARY_WEATHER=true
# COPILOT_SECRETARY_DEFAULT_TZ=Europe/Warsaw
